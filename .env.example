# Copie para .env e ajuste se quiser (o .env nao vai pro git)
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress_local
DB_ROOT_PASSWORD=root_local
WP_PORT=8080
PMA_PORT=8081

# Admin do WordPress local (usado no setup via WP-CLI)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=troque_esta_senha
WP_ADMIN_EMAIL=admin@mundogilda.test

# Mailpit (caixa de e-mails local)
MAIL_PORT=8026

# Endereço de origem da loja (cálculo de frete). CEP/cidade do requisito 10.1; rua a confirmar
STORE_ADDRESS="Endereço a confirmar"
STORE_CITY="Curitiba"
STORE_STATE=PR
STORE_CEP=82015-384

# Cliente de teste (para testar cadastro/compra localmente)
TEST_CUSTOMER_EMAIL=cliente.teste@mundogilda.test
TEST_CUSTOMER_PASSWORD=troque_esta_senha

# Meta Pixel (ID público do site atual). Só envia eventos em produção.
META_PIXEL_ID=2143468076438110
# 1 = mostra os eventos no console do navegador (fora de produção)
META_PIXEL_DEBUG=1
